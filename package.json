{
  "name": "x402-worker-template",
  "type": "module",
  "private": true,
  "description": "Payment-verified Cloudflare Worker template using Hono and x402 v2 on Base Sepolia.",
  "scripts": {
    "dev": "wrangler dev",
    "build:browser": "tsx scripts/build-browser.ts",
    "build": "npm run build:browser && wrangler deploy --dry-run --outdir=dist",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "pretest": "npm run build:browser",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:browser && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "buy": "tsx scripts/buy.ts",
    "buyer:diagnose": "tsx scripts/buyer-diagnose.ts"
  },
  "dependencies": {
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/extensions": "^2.19.0",
    "@x402/fetch": "^2.19.0",
    "@x402/hono": "^2.19.0",
    "hono": "^4.12.31",
    "viem": "^2.55.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/node": "^22.20.1",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0"
  }
}
