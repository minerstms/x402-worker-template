{
  "name": "x402-worker-template",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minerstms/x402-worker-template.git"
  },
  "homepage": "https://github.com/minerstms/x402-worker-template#readme",
  "bugs": {
    "url": "https://github.com/minerstms/x402-worker-template/issues"
  },
  "packageManager": "npm@10.9.8",
  "description": "Payment-verified Cloudflare Worker template using Hono and x402 v2 on Base Sepolia.",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:browser": "tsx scripts/build-browser.ts",
    "build": "npm run build:browser && wrangler deploy --dry-run --outdir=dist",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "pretest": "npm run build:browser && npm run build:mainnet:test && npm run build:mainnet:mock-harness:test",
    "build:mainnet:test": "wrangler deploy --dry-run -c wrangler.mainnet.toml --outdir=dist-mainnet",
    "build:mainnet:mock-browser": "tsx scripts/build-mainnet-mock-browser.ts",
    "build:mainnet:mock-harness:test": "npm run build:mainnet:mock-browser && wrangler deploy --dry-run -c wrangler.mainnet-mock-harness.toml --outdir=dist-mainnet-mock-harness",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:browser && tsc --noEmit",
    "typecheck:mainnet": "tsc --noEmit",
    "build:mainnet": "wrangler deploy --dry-run -c wrangler.mainnet.toml --outdir=dist-mainnet",
    "cf-typegen": "wrangler types",
    "buy": "tsx scripts/buy.ts",
    "buyer:diagnose": "tsx scripts/buyer-diagnose.ts",
    "verify:archive": "tsx scripts/verify-release-archive.ts",
    "security:scan:tracked": "node scripts/security-scan.mjs --tracked",
    "security:scan:history": "node scripts/security-scan.mjs --history",
    "security:scan:all": "node scripts/security-scan.mjs --all",
    "check:dependencies": "node scripts/check-dependency-pins.mjs",
    "check:docs": "node scripts/check-public-docs.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:actions": "node scripts/check-github-action-pins.mjs",
    "check:runtime": "node scripts/check-runtime-toolchain.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:archive": "node scripts/create-safe-archive.mjs"
  },
  "dependencies": {
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "@x402/extensions": "2.19.0",
    "@x402/fetch": "2.19.0",
    "@x402/hono": "2.19.0",
    "hono": "4.12.31",
    "viem": "2.55.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@types/node": "22.20.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7",
    "wrangler": "4.112.0"
  }
}
