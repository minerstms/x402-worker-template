# Buyer script environment example.
# Copy to .env.buyer locally. Never commit .env.buyer.
#
# Do NOT run scripts/buy.ts until a supervised Red-lane payment step.
# Leave EVM_PRIVATE_KEY empty here — never paste a real key into examples.
#
# EXPECTED_PAY_TO_ADDRESS is the seller receiving address you independently
# expect the Worker to advertise before signing any payment.
#
# EXPECTED_REMOTE_API_ORIGIN is optional for local-only use. Leave blank when
# testing against http://localhost:8787 or http://127.0.0.1:8787.
# For a remote workers.dev test, set it to the exact deployed origin only
# (scheme + hostname + optional port, no path/query/fragment/credentials).
# This is not a wallet secret and does not replace EXPECTED_PAY_TO_ADDRESS.
# Your buyer private key remains local and must never be committed.

API_URL=http://localhost:8787/v1/example?value=hello
EXPECTED_REMOTE_API_ORIGIN=
EVM_PRIVATE_KEY=
EXPECTED_PAY_TO_ADDRESS=0x000000000000000000000000000000000000dEaD
ALLOW_TESTNET_PAYMENT=false
X402_NETWORK=eip155:84532
